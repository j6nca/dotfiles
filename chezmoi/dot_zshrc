# Enable Homebrew
eval "$(/opt/homebrew/bin/brew shellenv)"

# User-local binaries: Claude Code's native installer symlinks `claude` here, and
# chezmoi drops the git-* helpers here too. Only add it if it exists.
[[ -d "$HOME/.local/bin" ]] && export PATH="$HOME/.local/bin:$PATH"

# Enable mise runtime manager
eval "$(mise activate zsh)"

# Enable Starship prompt
eval "$(starship init zsh)"

# 1Password CLI: use the desktop app's biometric unlock (Touch ID) instead of a
# separate `op signin`. Without this, `op` reports "no account" even when the
# app is unlocked and CLI integration is enabled in its settings.
export OP_BIOMETRIC_UNLOCK_ENABLED=true

# Claude Code mods (function-hook plugins) managed under ~/.claude/mods.
# Colon-separated; each folder loads as a --plugin-dir and hot-reloads on save.
export CLAUDE_CODE_PLUGIN_DIRS="$HOME/.claude/mods/usage-limits"

# Plugins
source $(brew --prefix)/share/zsh-autosuggestions/zsh-autosuggestions.zsh
source $(brew --prefix)/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

fastfetch
