{{/*
  Only bifrost and hypercharm are declared by hand. The homelab side is
  served by the pi-provider-litellm extension (see
  private_settings.json.tmpl), which discovers the proxy's catalog at startup
  -- /model/info first, falling back to /v1/models -- and registers each
  model_name it finds. A literal list here would be a second copy of the
  litellm ConfigMap that silently goes stale every time a model is added or a
  provider is retired, which is exactly what happened to the one this
  replaces.

  Neither provider gets that treatment: bifrost is not a LiteLLM proxy, so
  the extension cannot introspect it, and hypercharm -- also not a LiteLLM
  proxy -- happens to serve its catalog unauthenticated at
  GET /api/v1/models. hypercharm's entries below carry the context windows,
  output caps, effort ladders and prices that endpoint self-reports, so pi
  does not fall back to its 128k/16k defaults; re-pull the endpoint when they
  drift.
*/ -}}
{
  "providers": {
    "hypercharm": {
      "api": "openai-completions",
      "baseUrl": "https://hyper.charm.land/api/v1",
      "apiKey": "{{ onepasswordRead "op://lab/hypercharm-api/password" }}",
      "models": [
        {
          "id": "deepseek-v4-pro",
          "name": "DeepSeek V4 Pro",
          "reasoning": true,
          "thinkingLevelMap": {
            "off": null,
            "minimal": null,
            "low": null,
            "medium": null,
            "high": "high",
            "xhigh": "xhigh",
            "max": null
          },
          "contextWindow": 1000000,
          "maxTokens": 384000,
          "cost": { "input": 2.4, "output": 4.8, "cacheRead": 0.2, "cacheWrite": 0 }
        },
        {
          "id": "kimi-k3",
          "name": "Kimi K3",
          "reasoning": true,
          "thinkingLevelMap": {
            "off": null,
            "minimal": null,
            "low": "low",
            "medium": null,
            "high": "high",
            "max": "max"
          },
          "input": ["text", "image"],
          "contextWindow": 1048576,
          "maxTokens": 16000,
          "cost": { "input": 3.2664, "output": 16.332, "cacheRead": 0.32664, "cacheWrite": 0 }
        },
        {
          "id": "glm-5.3",
          "name": "GLM 5.3",
          "reasoning": true,
          "thinkingLevelMap": {
            "off": null,
            "minimal": null,
            "low": "low",
            "medium": null,
            "high": "high",
            "max": "max"
          },
          "contextWindow": 1000000,
          "maxTokens": 128000,
          "cost": { "input": 1.52432, "output": 4.79072, "cacheRead": 0.283088, "cacheWrite": 0 }
        },
        {
          "id": "minimax-m3",
          "name": "MiniMax M3",
          "reasoning": true,
          "thinkingLevelMap": {
            "off": null,
            "minimal": null,
            "low": "low",
            "medium": "medium",
            "high": "high"
          },
          "input": ["text", "image"],
          "contextWindow": 512000,
          "maxTokens": 512000,
          "cost": { "input": 0.32664, "output": 1.30656, "cacheRead": 0.064239, "cacheWrite": 0 }
        },
        {
          "id": "qwen3.8-max",
          "name": "Qwen3.8-Max",
          "reasoning": true,
          "thinkingLevelMap": {
            "off": "none",
            "minimal": "minimal",
            "low": "low",
            "medium": "medium",
            "high": "high"
          },
          "input": ["text", "image"],
          "contextWindow": 1000000,
          "maxTokens": 65536,
          "cost": { "input": 2, "output": 6, "cacheRead": 0.25, "cacheWrite": 0 }
        }
      ]
    }
{{- if eq .machine "stackadapt" }},
    "bifrost": {
      "api": "openai-completions",
      "baseUrl": "{{ onepasswordRead "op://Stackadapt/bifrost/url" | trimSuffix "/openai" }}/openai/v1",
      "apiKey": "{{ onepasswordRead "op://Stackadapt/bifrost/password" }}",
      "models": [
        { "id": "openai/gpt-5.5" },
        { "id": "openai/gpt-5.5-pro" },
        { "id": "openai/gpt-5.4" },
        { "id": "openai/gpt-5.3-codex" },
        { "id": "openai/gpt-5.1-codex-max" },
        { "id": "bedrock/anthropic.claude-opus-4-8" },
        { "id": "bedrock/anthropic.claude-opus-4-7" },
        { "id": "bedrock/anthropic.claude-sonnet-4-6" },
        { "id": "bedrock/claude-haiku-4-5-20251001" },
        { "id": "bedrock/zai.glm-5" },
        { "id": "gemini/gemini-3.1-pro-preview" },
        { "id": "fireworks/accounts/fireworks/models/deepseek-v4-pro" }
      ]
    },
    "bifrost-responses": {
      "api": "openai-responses",
      "baseUrl": "{{ onepasswordRead "op://Stackadapt/bifrost/url" | trimSuffix "/openai" }}/openai/v1",
      "apiKey": "{{ onepasswordRead "op://Stackadapt/bifrost/password" }}",
      "models": [
        { "id": "openai/gpt-6-astra" }
      ]
    }
{{- end }}
  }
}
