{{/*
  Only bifrost is declared by hand. The homelab side is served by the
  pi-provider-litellm extension (see private_settings.json.tmpl), which
  discovers the proxy's catalog at startup -- /model/info first, falling back
  to /v1/models -- and registers each model_name it finds. A literal list here
  would be a second copy of the litellm ConfigMap that silently goes stale
  every time a model is added or a provider is retired, which is exactly what
  happened to the one this replaces.

  Bifrost gets no such treatment because it is not a LiteLLM proxy; the
  extension cannot introspect it, so its models stay enumerated.
*/ -}}
{
  "providers": {
{{- if eq .machine "stackadapt" }}
    "bifrost": {
      "api": "openai-completions",
      "baseUrl": "{{ onepasswordRead "op://Stackadapt/bifrost/url" | trimSuffix "/openai" }}/openai/v1",
      "apiKey": "{{ onepasswordRead "op://Stackadapt/bifrost/password" }}",
      "models": [
        { "id": "openai/gpt-5.5" },
        { "id": "openai/gpt-5.5-pro" },
        { "id": "openai/gpt-5.4" },
        { "id": "openai/gpt-5.3-codex" },
        { "id": "openai/gpt-5.1-codex-max" },
        { "id": "bedrock/anthropic.claude-opus-4-8" },
        { "id": "bedrock/anthropic.claude-opus-4-7" },
        { "id": "bedrock/anthropic.claude-sonnet-4-6" },
        { "id": "bedrock/claude-haiku-4-5-20251001" },
        { "id": "bedrock/zai.glm-5" },
        { "id": "gemini/gemini-3.1-pro-preview" },
        { "id": "fireworks/accounts/fireworks/models/deepseek-v4-pro" }
      ]
    },
    "bifrost-responses": {
      "api": "openai-responses",
      "baseUrl": "{{ onepasswordRead "op://Stackadapt/bifrost/url" | trimSuffix "/openai" }}/openai/v1",
      "apiKey": "{{ onepasswordRead "op://Stackadapt/bifrost/password" }}",
      "models": [
        { "id": "openai/gpt-6-astra" }
      ]
    }
{{- end }}
  }
}
