{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "display": {
    "separator": " 󰁔 "
  },
  "modules": [
    "title",
    {
      "type": "custom",
      "format": "----------------------------------------"
    },
    "os",
    "host",
    "kernel",
    "uptime",
    "shell",
    "display",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "battery",
    "poweradapter",
    "localip",
    "locale",
    "break",
    "colors"
  ],
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "position": "left",
    "padding": {
      "top": 0,
      "left": 0,
      "right": 2
    }
  }
}
